{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ogy-kozosseg-mvp",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-19",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ogy-kozosseg-db",
			"database_id": "6085b408-f156-4017-bbf1-03416890e501",
			"migrations_dir": "migrations"
		},
		{
			"binding": "ogy_kozosseg_db",
			"database_name": "ogy-kozosseg-db",
			"database_id": "6085b408-f156-4017-bbf1-03416890e501",
			"remote": true
		}
	]
}