{
  "name": "ogy-kozosseg-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b",
    "db:local": "wrangler d1 migrations apply ogy-kozosseg-db --local",
    "db:seed": "wrangler d1 execute ogy-kozosseg-db --local --file=./fixtures/demo.sql",
    "db:remote": "wrangler d1 migrations apply ogy-kozosseg-db --remote",
    "db:remote:seed": "echo 'Nincs automatikus éles seedelés. A demóadatok csak lokális fejlesztésre valók.'",
    "test:import": "python -m unittest discover -s tests -p \"test_*.py\" -v"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.0",
    "@cloudflare/workers-types": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
